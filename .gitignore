# ==========================================
# Environments & Python Virtual Envs
# ==========================================
.venv/
venv/
.venv-et
env/
ENV/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# ==========================================
# Large Datasets & Raw Media
# ==========================================
data/*
!data/.gitkeep
vision/datasets/
# Ignore raw dataset images (not app resources)
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/raw/**/*.png
*.zip
*.tar.gz

# ==========================================
# Model Checkpoints, Weights & ExecuTorch Artifacts
# ==========================================
*.pth
*.pt
*.onnx
*.bin
*.safetensors
*.pte
*.hef
# Only ignore JSON inside models_src/ (weight sidecars)
models_src/*.json

# ==========================================
# IDEs, Editors & OS Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# ExecuTorch Build Artifacts & Submodule Overrides
# ==========================================
executorch/cmake-out/
executorch/build/
executorch/third-party/

# ==========================================
# Logs, Benchmarks & Temporary Files
# ==========================================
*.log
benchmarks/results/*.csv
!benchmarks/results/.gitkeep

# Local Model Checkpoint Directories
llm/checkpoints/
Llama-3.2-1B-Instruct/
